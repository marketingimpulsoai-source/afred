# ═══════════════════════════════════════════════════════════════════════
# ALFRED — Variables de Entorno
# Copie este archivo a .env y complete con sus claves reales.
# NINGUNA de estas claves es obligatoria para arrancar el servidor:
# sin ellas, Alfred opera en modo offline con respuestas de respaldo.
# ═══════════════════════════════════════════════════════════════════════

# ── Motor LLM (elija UNO; se detecta automáticamente por prioridad) ────
# 1) Gemini (recomendado, gratis con límites generosos)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
GEMINI_NANO_BANANA_ENABLED=true

# 2) OpenAI
OPENAI_API_KEY=

# 3) OpenRouter (acceso a cualquier modelo, incluido Claude)
OPENROUTER_API_KEY=

# Modelo específico a usar con el proveedor elegido (opcional)
ALFRED_LLM_MODEL=

# ── Voz (TTS) — opcional, si no se configura se usa Web Speech API local
# Config Alfred - Mayordomo Digital / Rupert preview
ELEVENLABS_API_KEY=
ALFRED_ELEVENLABS_AGENT_ID=agent_0001kzhcg3anecc9xmf62eceh6m9
ALFRED_TTS_VOICE_ID=89gcX1AeMGgcsN8ypHLu
ALFRED_TTS_MODEL_ID=eleven_v3_conversational
ALFRED_TTS_OUTPUT_FORMAT=mp3_44100_128
ALFRED_TTS_STABILITY=0.5
ALFRED_TTS_SIMILARITY_BOOST=0.8
ALFRED_TTS_SPEED=1
ALFRED_TTS_STYLE=0.35

# ── RevenueCat MCP — suscripciones, productos, entitlements, paywalls
# No guarde claves reales en Git ni en ZIPs públicos. Complete solo en .env local.
REVENUECAT_MCP_URL=https://mcp.revenuecat.ai/mcp
REVENUECAT_API_KEY=
REVENUECAT_AUTH_METHOD=bearer

# ── Media Router — Seedance 2.5, MiniMax y proveedores audiovisuales
# Complete claves reales solo en .env local. Nunca las guarde en Git/ZIP/docs/memoria.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=seedance-2.5
MINIMAX_SUBSCRIPTION_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io
PIXVERSE_API_KEY=
LUMA_API_KEY=
FAL_KEY=
RUNWARE_API_KEY=
COMFYUI_BASE_URL=
STITCH_MCP_API_KEY=
STITCH_MCP_PROJECT_ID=1063777121763794102

# ── Noticias / búsqueda web — Rutinas diarias (opcional)
# Complete solo en .env local o secret manager. Nunca guarde claves reales en Git.
SERPER_API_KEY=

# ── Servidor ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
