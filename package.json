{
  "name": "alfred-ai-butler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Alfred — Bilingual AI Butler (ES/EN). JARVIS-style orchestrator with 12 specialized sub-agents, semantic routing, persistent memory, and masculine bilingual voice.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.mjs data/alfred.db",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run smoke"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.62.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/pdfkit": "^0.17.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^11.3.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^4.68.4",
    "pdfkit": "^0.19.1",
    "playwright": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
